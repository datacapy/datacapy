{
  "name": "@datacapy/codegen",
  "type": "commonjs",
  "version": "0.1.0",
  "description": "Generate DataCapy schemas from tagged TypeScript interfaces",
  "main": "./dist/index",
  "types": "./dist/index.d.ts",
  "bin": {
    "datacapy-gen": "./dist/cli.js"
  },
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "jest",
    "build": "pnpm run clean && tsc",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf ./dist/*"
  },
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/datacapy/datacapy#readme",
  "bugs": {
    "url": "https://github.com/datacapy/datacapy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacapy/datacapy.git",
    "directory": "package/codegen"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@datacapy/schema": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
