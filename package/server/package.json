{
  "name": "@datacapy/server",
  "type": "commonjs",
  "version": "0.1.0",
  "description": "Datacapy server: REST API server over the object model",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm test",
    "build": "pnpm run clean && tsc && pnpm run build-minimise",
    "build-minimise": "find ./dist -type f -name '*.test.js' -delete && find ./dist -type f -name '*.test.js.map' -delete && find ./dist -type f -name '*.test.d.ts' -delete && find ./dist -type f -name '*.test.d.ts.map' -delete && find ./dist -type d -name 'test' -exec rm -rf {} + && find ./dist -type d -name 'test-utils' -exec rm -rf {} +",
    "clean": "rm -fr ./dist/*",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "test-fixtures-build": "cd ./src/test/fixtures && tsc",
    "test-fixtures-clean": "find ./src/test/fixtures -type f \\( -name '*.js' -or -name '*.js.map' -or -name '*.d.ts' \\) -delete",
    "prettier:check": "prettier --check src",
    "format": "prettier --write src"
  },
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/datacapy/datacapy#readme",
  "bugs": {
    "url": "https://github.com/datacapy/datacapy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacapy/datacapy.git",
    "directory": "package/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.8",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "express": "^5.2.1",
    "merge": "^2.1.1",
    "mongodb": "^6.21.0",
    "@datacapy/om": "workspace:*"
  },
  "files": [
    "/dist",
    "/tsconfig.json"
  ],
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "publishConfig": {
    "access": "public"
  }
}
