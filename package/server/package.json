{
  "name": "@datacapy/server",
  "type": "commonjs",
  "version": "2.0.1",
  "description": "Expose services as validated, access-controlled REST endpoints from config, on Express or Hono",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm test",
    "build": "pnpm run clean && tsc && pnpm run build-minimise",
    "build-minimise": "find ./dist -type f -name '*.test.js' -delete && find ./dist -type f -name '*.test.js.map' -delete && find ./dist -type f -name '*.test.d.ts' -delete && find ./dist -type f -name '*.test.d.ts.map' -delete && find ./dist -type f -name '*.type-test.*' -delete && find ./dist -type d -name 'test' -exec rm -rf {} + && find ./dist -type d -name 'test-utils' -exec rm -rf {} +",
    "clean": "rm -fr ./dist/*",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "test-fixtures-build": "cd ./src/test/fixtures && tsc",
    "test-fixtures-clean": "find ./src/test/fixtures -type f \\( -name '*.js' -or -name '*.js.map' -or -name '*.d.ts' \\) -delete",
    "prettier:check": "prettier --check src",
    "format": "prettier --write src"
  },
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/datacapy/datacapy#readme",
  "bugs": {
    "url": "https://github.com/datacapy/datacapy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacapy/datacapy.git",
    "directory": "package/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.11",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/proxy-addr": "^2.0.3",
    "@types/qs": "^6.9.18",
    "eslint": "^10.15.0",
    "hono": "^4.13.20",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "express": "^5.3.0"
  },
  "dependencies": {
    "@datacapy/om": "workspace:*",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.4.0",
    "merge": "^2.1.1",
    "mongodb": "^7.9.0",
    "proxy-addr": "^2.0.7",
    "qs": "^6.16.1"
  },
  "files": [
    "/dist",
    "/tsconfig.json"
  ],
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "hono": "^4.0.0",
    "@hono/node-server": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adaptor/express/index.d.ts",
      "default": "./dist/adaptor/express/index.js"
    },
    "./hono": {
      "types": "./dist/adaptor/hono/index.d.ts",
      "default": "./dist/adaptor/hono/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "express": [
        "dist/adaptor/express/index.d.ts"
      ],
      "hono": [
        "dist/adaptor/hono/index.d.ts"
      ]
    }
  }
}
