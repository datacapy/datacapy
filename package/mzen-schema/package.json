{
  "name": "mzen-schema",
  "type": "commonjs",
  "private": true,
  "version": "0.0.123",
  "description": "Mzen Schema",
  "main": "./dist/index",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm test",
    "test": "jest",
    "build": "pnpm run clean && tsc && pnpm run build-minimise",
    "build-minimise": "find ./dist -type d -name '*.test.ts' -exec rm -rf {} +",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf ./dist/*"
  },
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/kevin-foster-uk/mzen-schema",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevin-foster-uk/mzen-schema.git"
  },
  "dependencies": {
    "bson-objectid": "^1.3.1",
    "clone": "^2.1.2",
    "mzen-id": "workspace:*",
    "query": "github:kevin-foster-uk/query#mzen-query"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.37",
    "eslint": "^9.39.3",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.56.1"
  },
  "files": [
    "/dist",
    "/tsconfig.json"
  ]
}
