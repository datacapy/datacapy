{
  "name": "mzen-schema",
  "type": "commonjs",
  "version": "0.1.0",
  "description": "Mzen Schema",
  "main": "./dist/index",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm test",
    "test": "jest",
    "build": "pnpm run clean && tsc && pnpm run build-minimise",
    "build-minimise": "find ./dist -type d -name '*.test.ts' -exec rm -rf {} +",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf ./dist/*"
  },
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/kevin-foster-uk/mzen#readme",
  "bugs": {
    "url": "https://github.com/kevin-foster-uk/mzen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-foster-uk/mzen.git",
    "directory": "package/mzen-schema"
  },
  "dependencies": {
    "bson-objectid": "^2.0.4",
    "clone": "^2.1.2",
    "mzen-id": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "files": [
    "/dist",
    "/tsconfig.json"
  ]
}
