{
  "name": "mzen-id",
  "type": "commonjs",
  "private": true,
  "version": "0.0.1",
  "description": "Mzen Id",
  "main": "./dist/index",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm test",
    "test": "jest",
    "build": "pnpm run clean && tsc && pnpm run build-minimise",
    "build-minimise": "find ./dist -type d -name '_tests' -exec rm -rf {} +",
    "clean": "rm -rf ./dist/*",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/kevin-foster-uk/mzen-id",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevin-foster-uk/mzen-id.git"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "ts-node": "^10.7.0",
    "typescript": "^6.0.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.10"
  },
  "files": [
    "/dist",
    "/tsconfig.json"
  ]
}
