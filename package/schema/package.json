{
  "name": "@datacapy/schema",
  "type": "commonjs",
  "version": "0.1.0",
  "description": "Datacapy schema: data schema definition and validation",
  "main": "./dist/index",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "jest",
    "build": "pnpm run clean && tsc && pnpm run build-minimise",
    "build-minimise": "find ./dist -type d -name '*.test.ts' -exec rm -rf {} +",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf ./dist/*"
  },
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/datacapy/datacapy#readme",
  "bugs": {
    "url": "https://github.com/datacapy/datacapy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacapy/datacapy.git",
    "directory": "package/schema"
  },
  "dependencies": {
    "bson-objectid": "^2.0.4",
    "clone": "^2.1.2",
    "@datacapy/id": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.9.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "files": [
    "/dist",
    "/tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
