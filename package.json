{
  "name": "datacapy",
  "version": "0.1.0",
  "private": true,
  "description": "Datacapy",
  "scripts": {
    "build": "pnpm -r --stream build",
    "test": "pnpm -r --stream test",
    "clean": "pnpm -r --stream clean",
    "format": "pnpm -r --stream format",
    "typecheck": "pnpm -r --stream typecheck",
    "compile": "pnpm format && pnpm build && pnpm typecheck && pnpm test",
    "build:id": "pnpm --filter @datacapy/id build",
    "build:schema": "pnpm --filter @datacapy/schema build",
    "build:om": "pnpm --filter @datacapy/om build",
    "build:server": "pnpm --filter @datacapy/server build",
    "test:id": "pnpm --filter @datacapy/id test",
    "test:schema": "pnpm --filter @datacapy/schema test",
    "test:om": "pnpm --filter @datacapy/om test",
    "test:server": "pnpm --filter @datacapy/server test",
    "format:id": "pnpm --filter @datacapy/id format",
    "format:schema": "pnpm --filter @datacapy/schema format",
    "format:om": "pnpm --filter @datacapy/om format",
    "format:server": "pnpm --filter @datacapy/server format",
    "typecheck:id": "pnpm --filter @datacapy/id typecheck",
    "typecheck:schema": "pnpm --filter @datacapy/schema typecheck",
    "typecheck:om": "pnpm --filter @datacapy/om typecheck",
    "typecheck:server": "pnpm --filter @datacapy/server typecheck",
    "commit": "cz",
    "changeset": "changeset",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .git-commit-template.txt",
    "build:migrate": "pnpm --filter @datacapy/migrate build",
    "test:migrate": "pnpm --filter @datacapy/migrate test",
    "format:migrate": "pnpm --filter @datacapy/migrate format",
    "typecheck:migrate": "pnpm --filter @datacapy/migrate typecheck"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "keywords": [
    "monorepo",
    "datacapy"
  ],
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.3": ">=3.1.3",
      "qs@<6.14.1": ">=6.14.1",
      "ajv@<6.14.0": ">=6.14.0",
      "tmp@<0.2.6": ">=0.2.6"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cspell/dict-node": "^5.0.9",
    "@cspell/dict-npm": "^5.2.38",
    "@cspell/dict-typescript": "^3.2.3",
    "commitizen": "^4.3.1",
    "cspell": "^10.3.6",
    "cz-customizable": "^7.5.4",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
