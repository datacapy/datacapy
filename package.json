{
  "name": "mzen",
  "version": "0.1.0",
  "private": true,
  "description": "Mzen",
  "scripts": {
    "build": "pnpm -r --stream build",
    "test": "pnpm -r --stream test",
    "clean": "pnpm -r --stream clean",
    "format": "pnpm -r --stream format",
    "typecheck": "pnpm -r --stream typecheck",
    "compile": "pnpm format && pnpm build && pnpm typecheck && pnpm test",
    "build:mzen-id": "pnpm --filter mzen-id build",
    "build:mzen-schema": "pnpm --filter mzen-schema build",
    "build:mzen-om": "pnpm --filter mzen-om build",
    "build:mzen-server": "pnpm --filter mzen-server build",
    "test:mzen-id": "pnpm --filter mzen-id test",
    "test:mzen-schema": "pnpm --filter mzen-schema test",
    "test:mzen-om": "pnpm --filter mzen-om test",
    "test:mzen-server": "pnpm --filter mzen-server test",
    "format:mzen-id": "pnpm --filter mzen-id format",
    "format:mzen-schema": "pnpm --filter mzen-schema format",
    "format:mzen-om": "pnpm --filter mzen-om format",
    "format:mzen-server": "pnpm --filter mzen-server format",
    "typecheck:mzen-id": "pnpm --filter mzen-id typecheck",
    "typecheck:mzen-schema": "pnpm --filter mzen-schema typecheck",
    "typecheck:mzen-om": "pnpm --filter mzen-om typecheck",
    "typecheck:mzen-server": "pnpm --filter mzen-server typecheck",
    "commit": "cz",
    "changeset": "changeset",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .git-commit-template.txt"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "keywords": [
    "monorepo",
    "mzen"
  ],
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.3": ">=3.1.3",
      "qs@<6.14.1": ">=6.14.1",
      "ajv@<6.14.0": ">=6.14.0"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cspell/dict-node": "^5.0.9",
    "@cspell/dict-npm": "^5.2.38",
    "@cspell/dict-typescript": "^3.2.3",
    "commitizen": "^4.3.1",
    "cspell": "^10.0.0",
    "cz-customizable": "^7.5.4",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
